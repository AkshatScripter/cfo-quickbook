# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for the CFO QuickBooks portal.
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` — only this template is committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (auth only) ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key        # server-only — keep secret

# ── Database (Drizzle over Postgres) ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
MIGRATION_DATABASE_URL=                                # optional — overrides DATABASE_URL for drizzle-kit only

# ── Auth / roles ─────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@example.com                    # always gets super_admin on first login

# ── QuickBooks Online (Intuit OAuth) ─────────────────────────────────────────
QUICKBOOKS_CLIENT_ID=your_intuit_client_id
QUICKBOOKS_CLIENT_SECRET=your_intuit_client_secret
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
# API base URL. Defaults to sandbox if unset.
# Production: https://quickbooks.api.intuit.com
QUICKBOOKS_API_BASE=https://sandbox-quickbooks.api.intuit.com
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=from_intuit_developer_portal  # HMAC key for intuit-signature header
QUICKBOOKS_TOKEN_ENC_KEY=replace_with_64_char_hex              # AES-256-GCM key for token encryption at rest
                                                               # Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── Cron ─────────────────────────────────────────────────────────────────────
CRON_SECRET=generate_a_long_random_string              # Bearer token for /api/cron/* routes

# ── AI CFO agent (Groq) ──────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
