# ─────────────────────────────────────────────────────────────────────────────
# CFO QuickBooks Portal — environment variables
# Copy this file to `.env.local` and fill in every value before running.
# NEVER commit `.env.local` — only this template (.env.example) is committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Where to get: https://supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Database ──────────────────────────────────────────────────────────────────
# Where to get: https://supabase.com → your project → Settings → Database
#   → Connection string → Session mode (use the pooler URL for serverless)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Auth ──────────────────────────────────────────────────────────────────────
# The email address that always gets the super_admin role on first login.
# Set this to your own email when setting up.
SUPER_ADMIN_EMAIL=your-admin@example.com

# ── QuickBooks Online ─────────────────────────────────────────────────────────
# Where to get: https://developer.intuit.com → Dashboard → your app → Keys & credentials
QUICKBOOKS_CLIENT_ID=ABxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QUICKBOOKS_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Must exactly match what you register in the Intuit portal under "Redirect URIs"
# Development:  http://localhost:3000/api/quickbooks/callback
# Production:   https://yourdomain.com/api/quickbooks/callback
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback

# Sandbox (development) or production API base URL.
# Switch to https://quickbooks.api.intuit.com when going live.
QUICKBOOKS_API_BASE=https://sandbox-quickbooks.api.intuit.com

# Where to get: https://developer.intuit.com → your app → Webhooks
# Register your webhook URL there first, then copy the Verifier Token shown.
# Development webhook URL: use ngrok → https://<id>.ngrok.io/api/quickbooks/webhook
# Production webhook URL:  https://yourdomain.com/api/quickbooks/webhook
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AES-256-GCM key for encrypting QB OAuth tokens at rest in the database.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes). Keep the same across all instances
# that share a database — rotating this key requires all companies to reconnect QB.
QUICKBOOKS_TOKEN_ENC_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Cron ──────────────────────────────────────────────────────────────────────
# Secret that protects the /api/cron/sync endpoint from unauthorized calls.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── AI CFO Agent ──────────────────────────────────────────────────────────────
# Where to get: https://console.groq.com → API Keys → Create new key
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
